{
  "name": "gmail-detector",
  "version": "1.0.0",
  "description": "A Node.js app using the Gmail API to detect grammar and spelling issues in local files. It scans directories, creates temporary email drafts with file contents, and uses Gmail language analysis to extract suggested corrections. It supports batch processing and generates reports and logs of issues",
  "keywords": [
    "nodejs",
    "gmail-api",
    "grammar-checker",
    "spelling-checker",
    "text-analysis",
    "file-scanner",
